{
  "name": "dakinghilsman-media",
  "version": "1.0.0",
  "type": "module",
  "description": "Cost-efficient media hosting platform on Cloudflare",
  "scripts": {
    "dev": "wrangler pages dev dist --local",
    "build": "vite build && wrangler deploy",
    "build:frontend": "vite build",
    "build:worker": "wrangler deploy --dry-run",
    "deploy": "vite build && wrangler deploy",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "certs:generate": "node scripts/generate-certs.js",
    "certs:add": "node scripts/add-certs.js",
    "certs:list": "node scripts/list-certs.js",
    "certs:test": "node scripts/test-webhook.js",
    "certs:rotate": "node scripts/rotate-certs.js"
  },
  "dependencies": {
    "itty-router": "^5.0.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@azure/identity": "^3.4.0",
    "@azure/storage-blob": "^12.17.0",
    "@azure/keyvault-secrets": "^4.7.0",
    "@azure/service-bus": "^7.9.0",
    "@microsoft/microsoft-graph-client": "^3.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250108.0",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "wrangler": "^3.36.0"
  }
}
